{
  "name": "@eledo/n8n-nodes-eledo",
  "version": "1.0.6",
  "description": "Generate PDFs with Eledo directly in n8n workflows.",
  "license": "MIT",
  "homepage": "https://github.com/eledo-online/n8n-nodes-eledo#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "eledo",
    "pdf",
    "automation",
    "document-automation"
  ],
  "author": {
    "name": "Eledo",
    "email": "helpdesk@eledo.online"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eledo-online/n8n-nodes-eledo.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/EledoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Eledo/Eledo.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@vitest/coverage-v8": "^4.1.3",
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "prettier": "3.8.3",
    "release-it": "^19.2.4",
    "typescript": "6.0.2",
    "vitest": "^4.1.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
